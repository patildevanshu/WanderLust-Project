<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
    <div class="card p-4 p-md-5 border-0 shadow-sm">
      <h2 class="mb-4 text-center fw-bold">About WanderLust</h2>
      <p class="lead text-muted text-center mb-4">
        Connecting travelers with unforgettable stays and empowering hosts around the world.
      </p>
      
      <hr class="my-4">

      <h4 class="fw-semibold">Our Mission</h4>
      <p class="text-secondary">
        WanderLust was founded with a single mission: to make exploring unique, comfortable accommodations as effortless and accessible as possible. Whether you're seeking a secluded mountain cabin, an iconic city loft, or a beachfront villa, WanderLust provides a transparent, peer-to-peer vacation rental marketplace for adventurers worldwide.
      </p>

      <h4 class="fw-semibold mt-4">What Sets Us Apart</h4>
      <ul class="text-secondary">
        <li class="mb-2"><strong>Curated Categories:</strong> Discover spaces tailored to your travel style—from beachfront retreats to cozy cabins and castle getaways.</li>
        <li class="mb-2"><strong>Interactive Maps:</strong> Every listing is geocoded and pinned with Mapbox, so you know exactly where your next adventure awaits.</li>
        <li class="mb-2"><strong>Verified Reviews:</strong> Genuine feedback and ratings from verified guests help you choose the right place with confidence.</li>
        <li class="mb-2"><strong>Host Empowerment:</strong> Turn your spare room, second home, or unique architecture into an income stream with fast listing tools.</li>
      </ul>

      <h4 class="fw-semibold mt-4">Get in Touch</h4>
      <p class="text-secondary">
        Have questions, feedback, or need assistance with your listing or booking? Our team is always here to support you.
      </p>
      <div class="alert alert-light border p-3 d-flex align-items-center mt-3">
        <i class="fa-solid fa-envelope-open-text text-danger fs-3 me-3"></i>
        <div>
          <span class="d-block text-muted small">Customer Support & Inquiries</span>
          <a href="mailto:support@devanshupatil.tech" class="fw-bold text-danger text-decoration-none">
            support@devanshupatil.tech
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
