<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
    <div class="card p-4 p-md-5 border-0 shadow-sm">
      <h2 class="mb-3 text-center fw-bold">Press & Media</h2>
      <p class="text-muted text-center lead mb-4">Official news, media resources, and brand assets from WanderLust.</p>

      <hr class="my-4">

      <h5 class="fw-semibold">Recent Announcements</h5>
      <div class="list-group list-group-flush mb-4">
        <div class="list-group-item px-0 py-3">
          <span class="text-muted small d-block">September 2026</span>
          <h6 class="fw-bold mb-1">WanderLust Unveils Mobile-First Responsive Experience & Enhanced Geolocation</h6>
          <p class="text-secondary small mb-0">Upgrading search filters, responsive interactive maps, and touch controls for travelers on mobile devices worldwide.</p>
        </div>
        <div class="list-group-item px-0 py-3">
          <span class="text-muted small d-block">July 2026</span>
          <h6 class="fw-bold mb-1">WanderLust Reaches Milestone with Global Listings in Over 15 Countries</h6>
          <p class="text-secondary small mb-0">Accelerating peer-to-peer vacation rental bookings and expanding options for scenic, nature, and urban travelers.</p>
        </div>
      </div>

      <h5 class="fw-semibold mt-4">Media Inquiries & Press Kit</h5>
      <p class="text-secondary">
        Members of the press, journalists, and media creators can request high-resolution brand assets, interview requests, or background information by reaching out to our press office:
      </p>
      <div class="alert alert-light border p-3 d-flex align-items-center mt-3">
        <i class="fa-solid fa-newspaper text-danger fs-3 me-3"></i>
        <div>
          <span class="d-block text-muted small">Press & Communications Contact</span>
          <a href="mailto:support@devanshupatil.tech" class="fw-bold text-danger text-decoration-none">
            support@devanshupatil.tech
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
