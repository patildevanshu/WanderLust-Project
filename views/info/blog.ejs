<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
    <div class="text-center mb-5">
      <h2 class="fw-bold">WanderLust Travel Blog</h2>
      <p class="text-muted lead">Stories, destination guides, and hosting tips from our global community.</p>
    </div>

    <!-- Blog Article 1 -->
    <div class="card mb-4 border-0 shadow-sm overflow-hidden">
      <div class="row g-0">
        <div class="col-md-5">
          <img 
            src="https://images.unsplash.com/photo-1571896349842-33c89424de2d?auto=format&fit=crop&w=800&q=60" 
            class="img-fluid h-100 w-100 object-fit-cover" 
            alt="Mountain Cabins"
            style="min-height: 200px;"
          >
        </div>
        <div class="col-md-7">
          <div class="card-body p-4">
            <span class="badge bg-danger mb-2">Travel Tips</span>
            <h5 class="card-title fw-bold">Top 10 Hidden Gem Cabins for Quiet Weekend Retreats</h5>
            <p class="card-text text-secondary small">
              Escape the chaos of city life. Explore our handpicked collection of secluded forest retreats, mountain hideaways, and riverside sanctuaries that guarantee peace and clarity.
            </p>
            <span class="text-muted small"><i class="fa-regular fa-clock me-1"></i> 5 min read</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Blog Article 2 -->
    <div class="card mb-4 border-0 shadow-sm overflow-hidden">
      <div class="row g-0">
        <div class="col-md-5">
          <img 
            src="https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60" 
            class="img-fluid h-100 w-100 object-fit-cover" 
            alt="Beachfront Stays"
            style="min-height: 200px;"
          >
        </div>
        <div class="col-md-7">
          <div class="card-body p-4">
            <span class="badge bg-primary mb-2">Host Guide</span>
            <h5 class="card-title fw-bold">How to Stage Your Vacation Rental for 5-Star Reviews</h5>
            <p class="card-text text-secondary small">
              From lighting and photography to thoughtful welcome amenities, discover the small details that make a huge difference in your guest satisfaction and booking velocity.
            </p>
            <span class="text-muted small"><i class="fa-regular fa-clock me-1"></i> 7 min read</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Blog Article 3 -->
    <div class="card mb-4 border-0 shadow-sm overflow-hidden">
      <div class="row g-0">
        <div class="col-md-5">
          <img 
            src="https://images.unsplash.com/photo-1502784444187-359ac186c5bb?auto=format&fit=crop&w=800&q=60" 
            class="img-fluid h-100 w-100 object-fit-cover" 
            alt="Winter Wonderland"
            style="min-height: 200px;"
          >
        </div>
        <div class="col-md-7">
          <div class="card-body p-4">
            <span class="badge bg-info text-dark mb-2">Destinations</span>
            <h5 class="card-title fw-bold">The Ultimate Winter Packing List for Alpine Chalets</h5>
            <p class="card-text text-secondary small">
              Planning a ski trip in the Alps or Aspen? Check out our essential winter adventure gear guide to stay warm, stylish, and prepared on and off the slopes.
            </p>
            <span class="text-muted small"><i class="fa-regular fa-clock me-1"></i> 4 min read</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Support Callout -->
    <div class="card p-4 border-0 bg-light text-center mt-4">
      <h5>Have a travel story or hosting tip to share?</h5>
      <p class="text-muted small mb-3">We'd love to feature your journey on the WanderLust blog!</p>
      <div>
        <a href="mailto:support@devanshupatil.tech" class="btn btn-dark btn-sm">
          <i class="fa-regular fa-envelope me-1"></i> Submit a Pitch: support@devanshupatil.tech
        </a>
      </div>
    </div>
  </div>
</div>
