<% const flashSuccess = typeof success !== 'undefined' ? success : (locals.success || []); %>
<% const flashError = typeof error !== 'undefined' ? error : (locals.error || []); %>

<% if (flashSuccess && flashSuccess.length) { %>
<div class="row mt-2">
  <div class="alert alert-success alert-dismissible fade show col-12 col-md-6 offset-md-3" role="alert">
      <%= flashSuccess %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
</div>
<% } %>

<% if (flashError && flashError.length) { %>
<div class="row mt-2">
  <div class="alert alert-danger alert-dismissible fade show col-12 col-md-6 offset-md-3" role="alert">
      <%= flashError %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
</div>
<% } %>