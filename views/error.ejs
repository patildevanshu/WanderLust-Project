<% layout("layouts/boilerplate") %>

<div class="row mt-4">
  <div class="alert alert-danger col-12 col-md-6 offset-md-3 p-4 shadow-sm" role="alert">
    <h4 class="alert-heading"><i class="fa-solid fa-triangle-exclamation me-2"></i> Error</h4>
    <p class="mb-3"><%- err.message || "Something went wrong!" %></p>
    <hr>
    <a href="/listings" class="btn btn-sm btn-outline-danger">Back to Listings</a>
  </div>
</div>
